# ============================================================
# Local Medical ICD-10-CM Coding System - Environment Configuration
# ============================================================

# Environment & Diagnostics
ENVIRONMENT=development
DEBUG=false
OFFLINE_MODE=true

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# Local LLM (GPT4All / GGUF) Configuration
MODEL_NAME=mistral-7b-instruct-v0.2.Q4_K_M.gguf
MODEL_PATH=./models/gguf
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=1024
MODEL_THREADS=4
MODEL_CONTEXT_SIZE=2048

# Concurrency Architecture: Document-Level vs Model-Level
MAX_DOCUMENT_CONCURRENCY=10
MAX_LLM_CONCURRENCY=1

# Local Embeddings (SentenceTransformers) Configuration
EMBEDDING_MODEL_PATH=./models/embeddings/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Local ICD-10-CM Dataset & Prebuilt Indices
ICD_DATASET_PATH=./data/icd10/icd10cm_order_2026.txt
ICD_INDEX_DIR=./data/indexes

# Hybrid Retrieval Settings
BM25_TOP_K=15
FAISS_TOP_K=15
HYBRID_TOP_K=10
MIN_CANDIDATE_SCORE=0.40

# Asynchronous PDF Processing Guardrails
PDF_MAX_PAGES=50
PDF_TIMEOUT_SECONDS=120

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database Settings
DATABASE_URL=sqlite:///./data/medical_coding.db
